# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# Netlify
.netlify/

# OS / editor
.DS_Store
*.log

# Designer scratch previews
design/**/_*.jpg
werkbank/.sperre
werkbank/.gitsperre

# Messschrott der Kritiker in der Wurzel. Die Weglass-Renders der STADT (z1..z4)
# sind Arbeitsmaterial einer Messung, kein Ergebnis — 153 MB davon lagen schon da.
# Kritiker gehoeren in den Scratchpad; bis das ueberall sitzt, faengt das hier ab.
/z1/
/z2/
/z3/
/z4/

# Python-Zwischenstand
__pycache__/
*.pyc

# BELEGBILDER GEHOEREN NICHT IN DIE HISTORIE.
# Am 3. August 2026 lagen 1217 Schuesse mit 3,1 GB unter werkbank/schuss/ —
# 2,94 GB der 3,3 GB Historie dieses Zweigs. Damit war das Repo weder zu klonen
# noch zu holen: vier Hol-Strategien sind gerissen, fuenf Container-Ruecksetzungen
# liefen ins Leere. Die Bilder sind Arbeitsmaterial einer Messung, kein Ergebnis.
# Das Ergebnis ist das Urteil in Worten (werkbank/urteile/) und die gemessene
# Zahl (die .json neben dem Skript). Beides bleibt versioniert.
#
# Schiess weiter nach werkbank/schuss/ — die Messstaende lesen von dort. Nur
# wandern die Bilder nicht mehr mit. Skripte (.mjs .py .sh) und Messwerte (.json)
# sind ausgenommen und werden weiter mitgeschrieben.
werkbank/schuss/**/*.png
werkbank/schuss/**/*.jpg
werkbank/schuss/**/*.jpeg
werkbank/schuss/**/*.webp
werkbank/schuss/**/*.gif
werkbank/schuss/*.png
werkbank/schuss/*.jpg
werkbank/schuss/*.jpeg
werkbank/schuss/*.webp
werkbank/schuss/*.gif

# Und dasselbe fuer unkomprimierten Ton. DER KLANG hatte nach keiner halben
# Stunde 12 .wav-Blobs mit 20,2 MB in der Historie — je Durchgang eine neue
# Fassung, jede 1,9 MB. Die .webm daneben traegt dieselbe Aufnahme mit 236 KB,
# also einem Achtel, und ist das, was der blinde Kritiker abspielt. Die .wav
# bleiben auf der Platte liegen und sind aus der .webm jederzeit wieder
# herzustellen; sie wandern nur nicht mehr mit.
werkbank/schuss/**/*.wav
werkbank/schuss/*.wav

# AUSNAHME MIT ABSICHT: werkbank/beleg/ wird versioniert.
# Die Fortschrittsseite rendert je Stueck ein Bild. Als die 1217 Belegbilder aus
# der Historie fielen, gingen sieben davon mit und die Seite zeigte tote Rahmen.
# werkbank/beleg/ ist der kleine, gepflegte Ersatz: EIN Bild je Stueck, JPEG,
# 1280 breit, zusammen unter 2 MB. Es wird nachgeschossen, wenn sich das Stueck
# aendert, nicht angehaeuft. Wer hier etwas ablegt, prueft vorher die Groesse.
# Massenschuesse einer Messung gehoeren weiterhin nach werkbank/schuss/.
